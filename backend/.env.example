PORT=5001
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/restaurant?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/restaurant?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# AI Service Configuration
# Supports any of: Google Gemini, Groq, OpenAI, OpenRouter, NVIDIA NIM, or free automatic built-in fallback
